{
  "manifest_version": 3,
  "name": "Địa Bạ - Google Maps Profiler",
  "version": "1.1.0",
  "description": "Thu thập dữ liệu bổ sung từ Google Maps khi đã đăng nhập (Menu, Tiện ích, Giờ đặc biệt)",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://maps.google.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://localhost:3100/*",
      "https://godinescapebiz.netlify.app/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Địa Bạ Profiler"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
